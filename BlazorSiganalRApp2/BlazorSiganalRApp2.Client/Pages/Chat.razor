@page "/chat"
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Chat de Informatica UASD</PageTitle>

<div class="container py-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Sala de Chat - Estudiantes de informatica</h5>
            <span>
                @if (IsConnected)
                {
                    <span class="badge bg-success">Conectado</span>
                }
                else
                {
                    <span class="badge bg-danger">Desconectado</span>
                }
            </span>
        </div>

        <div class="card-body bg-light" style="height: 350px; overflow-y: auto;">
            @if (messages.Count == 0)
            {
                <div class="text-center text-muted mt-5">
                    <p class="mb-0">No hay mensajes todavía. ¡Comienza la conversación!</p>
                </div>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var msg in messages)
                    {
                        // Separamos el usuario del texto del mensaje (asumiendo el formato "Usuario: Mensaje")
                        var partes = msg.Split(':', 2);
                        var remitente = partes.Length > 0 ? partes[0].Trim() : "";
                        var esMio = !string.IsNullOrWhiteSpace(userInput) && remitente.Equals(userInput.Trim(), StringComparison.OrdinalIgnoreCase);

                        <li class="mb-2 d-flex @(esMio ? "justify-content-end" : "justify-content-start")">
                            <div class="p-2 rounded shadow-sm text-break" style="max-width: 75%; @(esMio ? "background-color: #d1e7dd; border-right: 4px solid #198754;" : "background-color: #ffffff; border-left: 4px solid #0d6efd;")">
                                <span class="d-block fw-bold small text-muted">@remitente</span>
                                <span>@(partes.Length > 1 ? partes[1].Trim() : "")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card-footer bg-white border-top-0 p-3">
            <div class="mb-3">
                <label for="userInput" class="form-label fw-bold text-secondary small">Tu Nombre / Usuario:</label>
                <input id="userInput" class="form-control" @bind="userInput" placeholder="Ej. Luis Manuel" />
            </div>

            <div class="mb-3">
                <label for="messageInput" class="form-label fw-bold text-secondary small">Mensaje:</label>
                <div class="input-group">
                    <input id="messageInput" class="form-control" @bind="messageInput" @onkeyup="HandleKeyUp" placeholder="Escribe tu mensaje aquí..." />
                    <button class="btn btn-primary px-4" @onclick="Send" disabled="@(!IsConnected)">
                        <i class="bi bi-send"></i> Enviar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private List<string> messages = [];
    private string? userInput;
    private string? messageInput;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<string, string>("ReceiveMessager", (user, message) =>
        {
            var encodedMsg = $"{user}: {message}";
            messages.Add(encodedMsg);
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task Send()
    {
        if (hubConnection is not null && !string.IsNullOrWhiteSpace(messageInput))
        {
            var user = string.IsNullOrWhiteSpace(userInput) ? "Anónimo" : userInput;

            await hubConnection.SendAsync("SendMenssage", user, messageInput);
            messageInput = string.Empty;
        }
    }
    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Send();
        }
    }

    public bool IsConnected =>
        hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}